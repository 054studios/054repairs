# Copy to .env.local (local development) and to Vercel → Project → Settings → Environment Variables.

# Required
NEXT_PUBLIC_SUPABASE_URL=https://zggntvxvbboqehpeakme.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xJwbP_HnPDLWGJxfwE8zXQ_QSMhm02P

# Recommended: the public address of the site, for example https://054repairs.vercel.app
# Without it, the site uses the request address (fine for local testing).
NEXT_PUBLIC_SITE_URL=

# Later (see README): server only, never prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=
# Generate with: openssl rand -base64 32
APP_ENCRYPTION_KEY=

# Later: e-mail confirmations via Resend
RESEND_API_KEY=
MAIL_FROM="054repairs <boekingen@example.nl>"

# Launch only: keep false while the Vercel version is being tested.
# Vercel preview deployments remain noindex even when this is true.
SITE_INDEXING_ENABLED=false
# Optional WhatsApp Business number, international digits (for example 31612345678).
WHATSAPP_NUMBER=

# Optional aggregate booking measurements; apply the 20261017 migration first.
NEXT_PUBLIC_FUNNEL_ENABLED=false
# Optional reminder mail. Activate only after migration + Resend setup.
REMINDERS_ENABLED=false
# At least 32 random characters. Vercel supplies it as Bearer authorization to cron.
CRON_SECRET=
